# TestFlight lane (paid Apple Developer account). Run by .github/workflows/ios-testflight.yml.
# Uses an App Store Connect API key, so no Apple ID password or 2FA is involved.
default_platform(:ios)

platform :ios do
  desc "Sign, build and upload Peek Pets to TestFlight"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: "com.lowluke.peekpets")
    update_code_signing_settings(
      path: "App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )
    increment_build_number(xcodeproj: "App.xcodeproj", build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s)
    build_app(project: "App.xcodeproj", scheme: "App", export_method: "app-store", output_name: "PeekPets.ipa")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
