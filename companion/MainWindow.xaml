<Window x:Class="PeekPets.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peek Pets Companion" Width="980" Height="720" MinWidth="780" MinHeight="580"
        Background="{StaticResource Paper}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Foreground="{StaticResource Ink}" WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: identity + pairing -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="2,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- A tiny Mochi that watches your cursor right here on the PC too. -->
                <Canvas x:Name="MiniPet" Width="64" Height="56" Margin="0,0,14,0">
                    <Ellipse Canvas.Left="4" Canvas.Top="49" Width="56" Height="7" Fill="#2A7A3B2A" />
                    <Path Fill="#F2735F" Data="M32,2 C50,2 60,18 62,34 C64,48 54,52 32,52 C10,52 0,48 2,34 C4,18 14,2 32,2 Z"/>
                    <Path Fill="#FFE9DD" Data="M32,13 C46,13 54,19 54,27 C54,36 45,40 32,40 C19,40 10,36 10,27 C10,19 18,13 32,13 Z"/>
                    <Ellipse Canvas.Left="15" Canvas.Top="19" Width="14" Height="14" Fill="White"/>
                    <Ellipse Canvas.Left="35" Canvas.Top="19" Width="14" Height="14" Fill="White"/>
                    <Ellipse x:Name="PupilL" Canvas.Left="17" Canvas.Top="21" Width="10" Height="10" Fill="#3A231E"/>
                    <Ellipse x:Name="PupilR" Canvas.Left="37" Canvas.Top="21" Width="10" Height="10" Fill="#3A231E"/>
                    <Path Stroke="#3A231E" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M29.5,34 Q32,36.2 34.5,34"/>
                </Canvas>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Peek Pets" FontSize="24" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Warn}" Margin="0,1,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Starting…" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="PAIR YOUR PHONE" Style="{StaticResource Heading}"/>
                    <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="196" Height="196" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Text="Point your iPhone camera at the code, tap the link, and you're paired. Same Wi-Fi needed."
                               TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,12,0,10" TextAlignment="Center"/>
                    <TextBlock Text="Or open this in Safari" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBox x:Name="UrlBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8"/>
                    <TextBlock Text="and enter code" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="CodeText" Text="––– –––" FontSize="34" FontWeight="Bold" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Coral}"/>
                    <TextBlock x:Name="ExpiryText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="New code" Style="{StaticResource PillButton}" Click="NewCode_Click" Margin="0,0,8,0"/>
                        <Button Content="Copy link" Style="{StaticResource PillButton}" Click="CopyLink_Click" Margin="0,0,8,0"/>
                        <Button Content="Open here" Style="{StaticResource PillButton}" Click="OpenHere_Click" ToolTip="Open the pet in this PC's browser to test"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- Right: tabs (phone + sharing, powers, labs scorecard) -->
        <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" x:Name="Tabs">
        <TabItem Header="Phone" Style="{StaticResource PillTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="FirewallBanner" Visibility="Collapsed" Background="#FFF0DC" CornerRadius="16" Padding="16,12" Margin="0,0,0,14" BorderBrush="#F5CF9F" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FirewallTitle" Text="Your phone may be blocked by Windows Firewall" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FirewallDetail" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Fix it…" Style="{StaticResource PillButton}" Click="FixFirewall_Click" VerticalAlignment="Center" Margin="12,0,0,0"
                                ToolTip="Runs Allow-Phone-Access.ps1 as administrator (Windows will ask first)"/>
                    </Grid>
                </Border>

                <Border x:Name="InstallCard" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6" VerticalAlignment="Top">
                            <Image x:Name="InstallQr" Width="104" Height="104" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="OPTIONAL · INSTALL AS AN APP" Style="{StaticResource Heading}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13">
                                Scan this to turn the pet into a home-screen app that opens even when this PC is off.
                                It walks you through trusting a private certificate that only works on your home network.
                            </TextBlock>
                            <TextBlock x:Name="SecureText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CONNECTED PHONES" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="RateText" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Muted}"/>
                        </Grid>
                        <TextBlock x:Name="NoPhonesText" Text="No phones yet. Scan the code to say hi." Foreground="{StaticResource Muted}"/>
                        <ItemsControl x:Name="PhoneList"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SHARING WITH YOUR PET" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Only what's switched on leaves this PC, and only to paired phones on your local network. Screen contents and keys are never read."
                                   TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-4,0,8"/>
                        <StackPanel x:Name="ShareToggles"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="SAY SOMETHING" Style="{StaticResource Heading}"/>
                            <TextBox x:Name="SayBox" MaxLength="80" Padding="8,6" BorderBrush="{StaticResource Line}" KeyDown="SayBox_KeyDown"/>
                            <Button Content="Send to pet" Style="{StaticResource PillButton}" Click="Say_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="NETWORK" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="NetworkText" TextWrapping="Wrap" FontSize="12.5"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>

        <TabItem Header="Powers" Style="{StaticResource PillTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="HELPFUL POWERS (LABS)" Style="{StaticResource Heading}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-4,0,8"
                                   Text="Experiments that let the pet help on this PC. A power runs only when it's allowed here AND switched on in the phone's Powers screen. Off means it reads nothing. The first time a phone uses any command, this PC asks you."/>
                        <StackPanel x:Name="PowerToggles"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="FAVOURITE APPS &amp; SITES (QUICK ACTIONS)" Style="{StaticResource Heading}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-4,0,8"
                                   Text="The phone can open these by name. It never sends a path or command itself. Websites (https://…), apps (.exe/.lnk) or folders."/>
                        <StackPanel x:Name="FavoritesList"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FavLabel" MaxLength="30" Padding="6,5" BorderBrush="{StaticResource Line}" ToolTip="Name shown on the phone"/>
                            <TextBox x:Name="FavTarget" Grid.Column="2" Padding="6,5" BorderBrush="{StaticResource Line}" ToolTip="https://… or a path to an app/shortcut/folder"/>
                            <Button Grid.Column="3" Content="Browse…" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="FavBrowse_Click"/>
                            <Button Grid.Column="4" Content="Add" Style="{StaticResource PillButton}" Margin="8,0,0,0" Click="FavAdd_Click"/>
                        </Grid>
                        <TextBlock x:Name="FavError" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="APPROVED COMMANDS" Style="{StaticResource Heading}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Open inbox" Style="{StaticResource PillButton}" Padding="10,4" FontSize="12" Margin="0,0,8,0" Click="OpenInbox_Click"/>
                                <Button Content="Reset approvals" Style="{StaticResource PillButton}" Padding="10,4" FontSize="12" Click="ResetApprovals_Click"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AutoAllowBox" Margin="0,2,0,8" Click="AutoAllow_Click" ToolTip="Paired phones run commands straight away. Reading the PC clipboard still asks.">
                            <TextBlock Text="Auto-allow my paired phones (no Allow? pop-up; clipboard reads still ask)" TextWrapping="Wrap" FontSize="12.5"/>
                        </CheckBox>
                        <TextBlock x:Name="ApprovedText" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>

        <TabItem Header="Labs scorecard" Style="{StaticResource PillTab}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="WHICH POWERS EARN THEIR PLACE?" Style="{StaticResource Heading}"/>
                            <Button Content="Reset counts" Style="{StaticResource PillButton}" Padding="10,4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetScores_Click"/>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,-4,0,10"
                                   Text="Counted on this PC only. Fired = the pet brought something up; Used = you tapped a command or answered 'done'; Dismissed = snoozed, skipped or closed."/>
                        <Grid x:Name="ScoreGrid"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="COMMAND AUDIT LOG" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="AuditText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono, Consolas" Text="No commands yet."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </TabItem>
        </TabControl>
    </Grid>
</Window>

